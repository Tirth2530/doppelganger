# Copy to .env and fill in. Placeholders only: never commit real values.

# Live agents and the replay engine (required for `bun run live` and `bun run live-eval`)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-chat-model-with-tool-calling
# Optional model settings, used identically by the agents and their replays
OPENAI_TEMPERATURE=
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_MS=30000

# Replay budget per reviewed action: past either cap the action is held for a human
REPLAY_MAX_MODEL_CALLS=400
REPLAY_DEADLINE_MS=180000

# Agent Relay (local: `npx -y agent-relay@next init` prints the workspace key)
RELAY_WORKSPACE_KEY=your-relay-workspace-key
RELAY_BASE_URL=http://127.0.0.1:8787

# Durable Actors (local: `bunx durable-actors dev`); or run `bun run live --memory`
DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7100
# Court actor id (default "webhooks"). Use a new id rather than deleting persisted state.
COURT_ID=

# Demo session
PORT=3000
DEMO_SESSION_MINUTES=180
# Set when phones reach the laptop through a tunnel, so the QR code points there
PUBLIC_URL=

# Slack review notifications (optional; unset = off, nothing else changes)
# An incoming-webhook URL: Slack app → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=
# The review link in each notification points at PUBLIC_URL (set above) or http://localhost:PORT.
# It carries no credential: the engineer's phone must be signed in with the on-call QR code first.
