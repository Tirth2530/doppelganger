      "name": "Executes only under current authority",
      "statement": "An operation reaches EXECUTED only if Infra holds authority for it at that moment and no revocation happened since it was approved."
    },
    {
      "id": "revocation",
      "name": "Revocation stops reviews in flight",
      "statement": "Evidence never approves an operation if Infra's authority was revoked while its review was running."
    },
    {
      "id": "laundering",
      "name": "Laundered requests are always reviewed",
      "statement": "An operation whose history reaches outside content is approved only by evidence or a human, never on submission."
    },
    {
      "id": "transitions",
      "name": "Only legal state transitions",
      "statement": "Every change follows the lifecycle; HELD leaves only by a human decision; EXECUTED and DENIED never change."
    },
    {
      "id": "config",
      "name": "Config is exactly what was executed",
      "statement": "The protected config always equals the default with each executed operation applied in order, and nothing else."
    },
    {
      "id": "authorized",
      "name": "Every execution is covered by its case's authorization",
